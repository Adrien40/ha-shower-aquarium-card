{
  "name": "ha-shower-aquarium-card",
  "private": true,
  "type": "module",
  "description": "Tooling for shower-aquarium-card.js: unit tests for the pure helper functions, a linter for all card JS, and the esbuild bundle that produces dist/shower-aquarium-card.js.",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "lit": "^3.3.3"
  }
}
