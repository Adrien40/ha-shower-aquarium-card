# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Text & configuration files
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.css text eol=lf
*.html text eol=lf

# Binary media assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf

# GitHub Linguist overrides
lit.js linguist-vendored
